# Copy to .env and fill in your own values. Never commit a real key.
# Local Postgres for development:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clientdesk_support?schema=public"
# Live AI answers (M3). Leave empty to run in demo mode, which quotes
# the help pages and needs no key. Get a free key at https://console.groq.com
GROQ_API_KEY=""
# Model for live answers (optional, this is the default):
# GROQ_MODEL="llama-3.3-70b-versatile"
